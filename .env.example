# =============================================================================
# WACAMS Environment Configuration Template
# =============================================================================
# Copy this file to .env and update values for your environment
# NEVER commit .env files to version control

# =============================================================================
# Database Configuration
# =============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=wacam_db
DB_USER=wacam_user
DB_PASSWORD=ChangeThisToASecurePassword!
DB_SSL_MODE=Prefer
DB_TRUST_SERVER_CERTIFICATE=true

# Connection string (auto-generated from above)
ConnectionStrings__WacamDb=Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD};SSL Mode=${DB_SSL_MODE};Trust Server Certificate=${DB_TRUST_SERVER_CERTIFICATE}

# =============================================================================
# JWT Authentication
# =============================================================================
# Generate a strong random key (minimum 32 characters)
JWT_KEY=Generate-A-Very-Long-And-Secure-Random-Key-Here-Minimum-32-Chars
JWT_ISSUER=WACAMS
JWT_AUDIENCE=WACAMS-API
JWT_EXPIRATION_MINUTES=480

# =============================================================================
# Application Settings
# =============================================================================
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Timezone for shift calculations
TZ=Africa/Johannesburg

# =============================================================================
# GIS iWork Integration
# =============================================================================
GIS__BaseUrl=https://gis.yfpo.com:9105
GIS__Username=sntseke1
GIS__Password=ChangeThisToSecurePassword
GIS__SyncIntervalMinutes=60
GIS__MaxRetryAttempts=3
GIS__RetryDelaySeconds=30
GIS__EnableScheduledSync=true

# =============================================================================
# Email Configuration (SMTP)
# =============================================================================
Email__SmtpHost=smtp.yourcompany.com
Email__SmtpPort=587
Email__SmtpUsername=noreply@yourcompany.com
Email__SmtpPassword=ChangeThisToSecurePassword
Email__FromAddress=noreply@yourcompany.com
Email__FromName=WACAMS System
Email__EnableSsl=true

# =============================================================================
# Azure Blob Storage (for signed forms)
# =============================================================================
AzureStorage__ConnectionString=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net
AzureStorage__ContainerName=signed-forms
AzureStorage__EnableBlobStorage=false

# =============================================================================
# Logging Configuration
# =============================================================================
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore=Warning
Logging__LogLevel__WACAMS=Information

# Application Insights (optional)
ApplicationInsights__InstrumentationKey=
ApplicationInsights__Enable=false

# =============================================================================
# Feature Flags
# =============================================================================
Features__EnableNotifications=true
Features__EnableEscalations=true
Features__EnableAuditLogging=true
Features__EnableBackgroundJobs=true

# =============================================================================
# Security Settings
# =============================================================================
Security__MaxLoginAttempts=5
Security__LockoutDurationMinutes=15
Security__PasswordMinLength=8
Security__PasswordRequireUppercase=true
Security__PasswordRequireLowercase=true
Security__PasswordRequireDigit=true
Security__PasswordRequireSpecialChar=true

# =============================================================================
# CORS Configuration
# =============================================================================
CORS__AllowedOrigins=http://localhost:3000,https://yourdomain.com
CORS__AllowCredentials=true

# =============================================================================
# Rate Limiting
# =============================================================================
RateLimiting__Enable=true
RateLimiting__RequestsPerMinute=60
RateLimiting__BurstLimit=10

# =============================================================================
# Health Checks
# =============================================================================
HealthChecks__EnableDetailedErrors=false
HealthChecks__ShowHealthStatusInUI=true
