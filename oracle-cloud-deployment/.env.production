# =============================================================================
# WACAMS Production Environment Variables - Oracle Cloud Deployment
# =============================================================================
# Copy this file to .env and update with your actual values
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
NODE_ENV=production
APP_NAME=WACAMS
APP_VERSION=1.0.0
APP_PORT=3000
API_PORT=8080

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wacams
POSTGRES_USER=wacams
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Connection Pool Settings
DB_POOL_MIN=10
DB_POOL_MAX=100
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_DB=0

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_THIS_JWT_SECRET_KEY_MIN_32_CHARS
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# GIS Integration
# -----------------------------------------------------------------------------
GIS_BASE_URL=https://gis.yfpo.com:9105
GIS_SSO_URL=https://gis.yfpo.com:9105/public/sp/sso/yfjwt5
GIS_USERNAME=sntseke1
GIS_PASSWORD=CHANGE_THIS_GIS_PASSWORD
GIS_ENTERPRISE_ID=yf
GIS_SYNC_INTERVAL=300
GIS_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Email Configuration (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourcompany.com
SMTP_PASSWORD=CHANGE_THIS_SMTP_PASSWORD
SMTP_FROM_NAME=WACAMS System
SMTP_FROM_EMAIL=noreply@yourcompany.com

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/storage
STORAGE_MAX_SIZE=10485760
STORAGE_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Oracle Cloud Object Storage (alternative)
# STORAGE_TYPE=oracle
# OCI_BUCKET_NAME=wacams-storage
# OCI_NAMESPACE=your-namespace
# OCI_REGION=af-johannesburg-1
# OCI_ACCESS_KEY=CHANGE_THIS
# OCI_SECRET_KEY=CHANGE_THIS

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
PROMETHEUS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30000

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
CORS_ORIGIN=https://your-domain.com
CORS_CREDENTIALS=true
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
CONTENT_SECURITY_POLICY=default-src 'self'
SSL_REDIRECT=true
HSTS_MAX_AGE=31536000

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_WEEKS=12
BACKUP_RETENTION_MONTHS=12
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=false

# Oracle Cloud Backup
OCI_BACKUP_ENABLED=true
OCI_BACKUP_BUCKET=wacams-backups
OCI_BACKUP_RETENTION=90

# -----------------------------------------------------------------------------
# Domain & SSL
# -----------------------------------------------------------------------------
DOMAIN=wacams.yourcompany.com
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
SSL_CHAIN_PATH=/etc/nginx/ssl/chain.pem

# Let's Encrypt (alternative)
# LETSENCRYPT_EMAIL=admin@yourcompany.com
# LETSENCRYPT_DOMAINS=wacams.yourcompany.com

# -----------------------------------------------------------------------------
# Oracle Cloud Infrastructure
# -----------------------------------------------------------------------------
OCI_REGION=af-johannesburg-1
OCI_TENANCY_ID=ocid1.tenancy.oc1..aaaaaaa...
OCI_USER_ID=ocid1.user.oc1..aaaaaaa...
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_PRIVATE_KEY_PATH=/root/.oci/oci_api_key.pem
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..aaaaaaa...

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_AUTO_ESCALATION=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_SMS_NOTIFICATIONS=false
FEATURE_GIS_SYNC=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_EXPORT_REPORTS=true

# -----------------------------------------------------------------------------
# Performance Tuning
# -----------------------------------------------------------------------------
WORKER_PROCESSES=auto
WORKER_CONNECTIONS=4096
NODE_OPTIONS=--max-old-space-size=4096
UV_THREADPOOL_SIZE=128

# -----------------------------------------------------------------------------
# Development/Testing (set to false in production)
# -----------------------------------------------------------------------------
DEBUG_MODE=false
MOCK_DATA=false
SEED_DATABASE=false
